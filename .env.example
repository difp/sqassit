# Скопируйте этот файл в .env и заполните реальными значениями.
# ФАЙЛ .env НИКОГДА не попадает в Git (см. .gitignore).

# Токен бота от @BotFather — обязателен.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# telegram_id тренера (администратора Web App). Получается у @userinfobot.
COACH_TELEGRAM_ID=123456789

# Часовой пояс для отображения тренировок.
TIMEZONE=Europe/Moscow

# Путь к файлу базы данных. На Render с диском: /var/data/squash.db.
DB_PATH=./data/squash.db

# Каталог дискового кэша аватарок. В бэкапы не входит, его можно удалить:
# картинки заново скачаются из Telegram при первом запросе.
AVATAR_CACHE_DIR=./data/cache/avatars

# Режим доставки апдейтов: polling (по умолчанию) или webhook.
BOT_MODE=polling

# Опционально: HTTP/SOCKS5-прокси для api.telegram.org.
# Примеры: socks5://127.0.0.1:1080, http://user:pass@proxy:3128
BOT_PROXY=

# Публичный HTTPS-адрес приложения (без слэша на конце).
# Нужен для webhook и для кнопки Web App в боте (даже при BOT_MODE=polling).
WEBHOOK_BASE_URL=https://example.com

# ТОЛЬКО при BOT_MODE=webhook. Сгенерируйте случайное значение:
#   openssl rand -hex 32
# Пустое/короткое значение или placeholder — приложение не стартует.
WEBHOOK_SECRET=

# С какого момента телефон обязателен для новых записей на тренировки/матчи.
# Пустое значение — проверка отключена (удобно локально).
# Пример: 2026-10-24T00:00:00+03:00
PHONE_REQUIRED_FROM=

# Новые записи на тренировки/матчи требуют подтверждения создателя.
REQUIRE_EVENT_APPROVAL=false

# ТОЛЬКО ДЛЯ ЛОКАЛЬНОЙ РАЗРАБОТКИ. Разрешает в dev-режиме передавать
# initData в query для скачивания .ics (превью вне Telegram).
# В продакшене обязательно false.
ALLOW_DEV_INIT_DATA=false

# OpenAPI (/docs, /openapi.json). В продакшене держите false.
ENABLE_API_DOCS=false
